# Only need to run the first part of FEFF to get SC params.
CONTROL 1 0 0 0 0 0
# Print out the atomic information as well. You can
# get the atomic energy levels, and thus spin orbit 
# coupling from this.
PRINT 5 0 0 0 0 0

# Set the edge. This controls where the core-hole is placed.
EDGE L2

# Control of the self-consistency loop
SCF 5.0000000000 0 100 0.0500000000 0

# Set the initial configuration of the atom.
# SC parameters are only calculated for the occupied states.
# The default configuration has only 3d3/2 occupied, so here
# I changed it to 3 3d3/2 + 1 3d5/2 occupation so that 3d5/2
# would be included.
# CONFIG card 1 meand read the configuration from this file,
# with one line of input below the CONFIG keyword. Line after 
# is:
# ipot Element occupation_label occupations
# where occupation_label is 1s, 2s, 2p, etc, and occupations
# is a single integer (1 or 2) for s states, and 2 integers
# corresponding to the spin-orbit split states for all other
# states. You need to define all occupied states starting from
# 1s. Negative occupation means treat this state as a frozen core
# state (not participating in self-consistency).
CONFIG card 1
  0      Cr       1s -2 2s -2 2p -2 -4 3s -2 3p -2 -4 3d 3 1 4s 1 4p 1 0

# Add a core-hole to the 0 potential. This will simulate the SC parameters
# in a final state. In addition, this also puts an extra electron in the 
# valence.
#
# If you want to simulate the initial state, use 
# COREHOLE NONE. 
COREHOLE FSR

# Define the different potentials for this system.
# POTENTIALS
# ipot Z label lscf lfms stoichiometry magnetic_moment
# Note that in these calculations the magnetic moment 
# is not used.
  POTENTIALS
  0 24 Cr -1 -1 0.0100000000 3.0280000000
  1 24 Cr -1 -1 2.0000000000 0.0000000000
  2 16 S -1 -1 2.0000000000 0.0000000000
  3 35 Br -1 -1 2.0000000000 0.0000000000

# Define the structure (x, y, z, ipot) where ipot is the potential index.
ATOMS
0.0000000000 0.0000000000 0.0000000000 0 0.0000000000
